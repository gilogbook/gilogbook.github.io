---
const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? "gilogbook";
const description = frontmatter?.description ?? "";
const category = frontmatter?.category ?? "";
const raw = frontmatter?.pubDate;
let dateText = "";
if (raw) {
  const d = new Date(raw);
  if (!isNaN(d.getTime())) {
    dateText =
      d.getFullYear() +
      "-" +
      String(d.getMonth() + 1).padStart(2, "0") +
      "-" +
      String(d.getDate()).padStart(2, "0");
  }
}
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — gilogbook</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href="/">
        <span class="en">Record of Rules</span>
        <span class="ko">gilogbook</span>
      </a>
      <nav>
        <a href="/methodology">방법론</a>
        <a href="/about">소개</a>
      </nav>
    </header>

    <main>
      <div class="doc-head">
        {category && <div class="cat">{category}</div>}
        <h1>{title}</h1>
        {dateText && <div class="date">{dateText}</div>}
      </div>

      <article>
        <slot />
      </article>
    </main>

    <footer>
      실제 자금이 투입되지 않은 모의 운용 기록이며, 투자 권유가 아닙니다.<br />
      개별 종목에 대한 문의에는 답변하지 않습니다.<br />
      과거 기록은 소급 수정하지 않습니다. 모든 변경은 커밋 이력에 남습니다.
    </footer>

    <style is:global>
      :root {
        --paper: #edf0ea;
        --band: #e4e8de;
        --rule: #c2ccbd;
        --rule-hard: #9ba896;
        --ink: #1b211a;
        --ink-soft: #5c6558;
        --ink-faint: #8a9384;
        --seal: #9b2c22;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: "IBM Plex Sans KR", system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.75;
        padding: 0 20px 72px;
      }
      .masthead {
        max-width: 720px;
        margin: 0 auto;
        padding: 28px 0 14px;
        border-bottom: 2px solid var(--rule-hard);
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
      }
      .brand { text-decoration: none; color: var(--ink); }
      .brand .en {
        display: block;
        font-family: "Archivo", sans-serif;
        font-weight: 900;
        font-size: 10px;
        letter-spacing: 0.22em;
        color: var(--ink-faint);
        margin-bottom: 4px;
      }
      .brand .ko { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; }
      nav { display: flex; gap: 18px; }
      nav a {
        font-size: 13.5px;
        color: var(--ink-soft);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      nav a:hover { color: var(--ink); border-bottom-color: var(--rule-hard); }

      main { max-width: 720px; margin: 0 auto; }
      .doc-head { padding: 36px 0 10px; border-bottom: 1px solid var(--rule); }
      .cat {
        font-family: "Archivo", sans-serif;
        font-weight: 700;
        font-size: 10.5px;
        letter-spacing: 0.18em;
        color: var(--seal);
        text-transform: uppercase;
        margin-bottom: 8px;
      }
      .doc-head h1 {
        font-size: clamp(26px, 5vw, 34px);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.25;
      }
      .date {
        font-family: "IBM Plex Mono", monospace;
        font-size: 12px;
        color: var(--ink-faint);
        margin-top: 10px;
      }

      article { padding-top: 26px; }
      article > * + * { margin-top: 20px; }
      article h2 {
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin-top: 40px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--rule);
      }
      article h3 { font-size: 16px; font-weight: 700; margin-top: 28px; }
      article p { line-height: 1.85; }
      article strong { font-weight: 700; }
      article a { color: var(--seal); text-decoration: underline; text-underline-offset: 3px; }
      article ul, article ol { padding-left: 22px; }
      article li { margin-top: 8px; line-height: 1.8; }
      article hr { border: none; border-top: 1px solid var(--rule); margin: 36px 0; }
      article blockquote {
        border-left: 3px solid var(--rule-hard);
        padding-left: 16px;
        color: var(--ink-soft);
      }
      article code {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.9em;
        background: var(--band);
        padding: 1px 5px;
      }
      article table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
      article th {
        text-align: left;
        font-family: "Archivo", sans-serif;
        font-weight: 700;
        font-size: 10.5px;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--ink-faint);
        padding: 9px 10px;
        border-bottom: 1.5px solid var(--rule-hard);
      }
      article td { padding: 9px 10px; border-bottom: 1px solid var(--rule); }
      article tbody tr:nth-child(even) td { background: var(--band); }
      article > p:last-child { color: var(--ink-soft); font-size: 14px; }

      footer {
        max-width: 720px;
        margin: 48px auto 0;
        padding-top: 18px;
        border-top: 1px solid var(--rule);
        font-family: "IBM Plex Mono", monospace;
        font-size: 11.5px;
        line-height: 2;
        color: var(--ink-faint);
      }

      @media (max-width: 640px) {
        body { font-size: 15.5px; padding: 0 16px 56px; }
        .masthead { padding-top: 20px; }
      }
    </style>
  </body>
</html>
